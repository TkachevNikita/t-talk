{
  "hosting": {
    "public": "dist/t-talk/browser",
    "ignore": [
      "firebase.json",
      "/.*",
      "/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/javascript"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "!**/*.@(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|otf|eot)",
        "destination": "/index.html"
      }
    ]
  }
}
